<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             xmlns:vm="using:ZapretGui.ViewModels"
             xmlns:models="using:ZapretGui.Models"
             x:Class="ZapretGui.Views.ServiceView"
             x:DataType="vm:ServiceViewModel">

    <UserControl.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="22"/>
        </Style>

        <Style Selector="TextBlock.card-title">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
        </Style>

        <Style Selector="TextBlock.card-desc">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="LineHeight" Value="18"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
        </Style>

        <Style Selector="Border.icon-box">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Opacity" Value="0.95"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource PaletteSecondary}"/>
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18,11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.9"/>
        </Style>
        <Style Selector="Button.primary:pressed /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.78"/>
        </Style>

        <Style Selector="Button.ghost">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="38"/>
        </Style>
        <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseMediumLowBrush}"/>
        </Style>

        <Style Selector="Button.icon-btn">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.icon-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseMediumLowBrush}"/>
        </Style>

        <Style Selector="Border.chip">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>

        <Style Selector="Button.chip-remove">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.chip-remove:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#C42B1C"/>
        </Style>
        <Style Selector="Button.chip-remove:pointerover Path">
            <Setter Property="Fill" Value="White"/>
        </Style>
        <Style Selector="Button.chip-remove:pointerover svg|Svg">
            <Setter Property="CurrentColor" Value="White"/>
        </Style>

        <Style Selector="TextBlock.empty">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
            <Setter Property="Margin" Value="2,8,0,8"/>
        </Style>

        <Style Selector="Border.badge">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="TextBox">
            <Setter Property="MinHeight" Value="40"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="MinHeight" Value="40"/>
        </Style>
    </UserControl.Styles>

    <Grid>
        <Grid RowDefinitions="Auto, *" Margin="28">
            <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Margin="0,0,0,24">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Loc[ServiceViewTitle]}" FontSize="26" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Loc[ServiceViewSubtitle]}"
                                   FontSize="13"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
            <TabControl Grid.Row="1" Padding="0" Margin="0">
                <TabItem Header="{Binding Loc[TabIpSettings]}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                        <StackPanel Spacing="16">
                            <Grid ColumnDefinitions="*, *" ColumnSpacing="18">
                                <Border Grid.Column="0" Classes="card">
                                    <StackPanel Spacing="14">
                                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                                            <Border Grid.Column="0" Classes="icon-box">
                                                <svg:Svg Path="/Assets/ico/ip.svg"
                                                         Width="24" Height="24"
                                                         CurrentColor="#FFFFFFFF"
                                                         Stretch="Uniform"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Classes="card-title"
                                                           Text="{Binding Loc[BtnUpdateIpset]}"/>
                                                <TextBlock Classes="card-desc"
                                                           Text="{Binding Loc[IpUpdateHint]}"/>
                                            </StackPanel>
                                        </Grid>

                                        <Button Classes="primary accent"
                                                Command="{Binding UpdateIpsetCommand}"
                                                HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <svg:Svg Path="/Assets/ico/download.svg"
                                                         Width="16" Height="16"
                                                         CurrentColor="#FFFFFFFF"
                                                         Stretch="Uniform"
                                                         VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Loc[Update]}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Classes="card">
                                    <StackPanel Spacing="14">
                                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                                            <Border Grid.Column="0" Classes="icon-box">
                                                <svg:Svg Path="/Assets/ico/hosts.svg"
                                                         Width="24" Height="24"
                                                         CurrentColor="#FFFFFFFF"
                                                         Stretch="Uniform"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Classes="card-title"
                                                           Text="{Binding Loc[BtnUpdateHosts]}"/>
                                                <TextBlock Classes="card-desc"
                                                           Text="{Binding Loc[IpUpdateHint]}"/>
                                            </StackPanel>
                                        </Grid>

                                        <Button Classes="primary accent"
                                                Command="{Binding UpdateHostsCommand}"
                                                HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <svg:Svg Path="/Assets/ico/download.svg"
                                                         Width="16" Height="16"
                                                         CurrentColor="#FFFFFFFF"
                                                         Stretch="Uniform"
                                                         VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Loc[Update]}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Classes="card">
                                <StackPanel Spacing="14">

                                    <TextBlock Classes="card-title"
                                               Text="{Binding Loc[IpExcludeHint]}"
                                               VerticalAlignment="Center"/>

                                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding ExcludeIpText, Mode=TwoWay}"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 FontFamily="Consolas, Cascadia Code"
                                                 FontSize="12"
                                                 MinHeight="80"
                                                 PlaceholderText="{Binding Loc[IpExcludeWatermark]}"
                                                 VerticalContentAlignment="Top"
                                                 CornerRadius="10"/>
                                        <Button Grid.Column="1"
                                                Classes="primary accent"
                                                Command="{Binding SaveExcludeIpsCommand}"
                                                VerticalAlignment="Stretch"
                                                Padding="16,0">
                                            <TextBlock Text="{Binding Loc[BtnSaveExcludeIps]}"
                                                       VerticalAlignment="Center"/>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{Binding Loc[TabSiteLists]}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="18">
                            <Border Grid.Column="0" Classes="card">
                                <StackPanel Spacing="14">

                                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                                        <Border Grid.Column="0" Classes="icon-box">
                                            <svg:Svg Path="/Assets/ico/whitelist.svg"
                                                     Width="24" Height="24"
                                                     CurrentColor="#FFFFFFFF"
                                                     Stretch="Uniform"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Classes="card-title"
                                                       Text="{Binding Loc[CurrentSites]}"/>
                                            <TextBlock Classes="card-desc"
                                                       Text="{Binding Loc[SiteAddHint]}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding NewSiteText, Mode=TwoWay}"
                                                 PlaceholderText="example.com"
                                                 CornerRadius="10"/>
                                        <Button Grid.Column="1"
                                                Classes="primary accent"
                                                Command="{Binding AddSiteCommand}"
                                                Padding="20,0"
                                                VerticalAlignment="Stretch">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Path Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"
                                                      Fill="White" Width="12" Height="12" Stretch="Uniform"
                                                      VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Loc[BtnAddSite]}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <Grid ColumnDefinitions="*, Auto" Margin="0,4,0,0">
                                        <TextBlock Grid.Column="0"
                                                   Text="Список доменов"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Classes="badge">
                                            <TextBlock Text="{Binding Sites.Count}"
                                                       FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>

                                    <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                            CornerRadius="10" Padding="10" MinHeight="120" MaxHeight="280">
                                        <Grid>
                                            <TextBlock Classes="empty"
                                                       Text="Нет добавленных сайтов"
                                                       IsVisible="{Binding !Sites.Count}"/>
                                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                          IsVisible="{Binding Sites.Count}">
                                                <ItemsControl ItemsSource="{Binding Sites}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Classes="chip">
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <TextBlock Text="{Binding}"
                                                                               FontFamily="Consolas, Cascadia Code"
                                                                               FontSize="12"
                                                                               VerticalAlignment="Center"/>
                                                                    <Button Classes="chip-remove"
                                                                            Command="{Binding $parent[UserControl].DataContext.RemoveSiteCommand}"
                                                                            CommandParameter="{Binding}"
                                                                            ToolTip.Tip="Удалить">
                                                                        <svg:Svg Path="/Assets/ico/x.svg"
                                                                                 Width="12" Height="12"
                                                                                 CurrentColor="{DynamicResource SvgIconColor}"
                                                                                 Stretch="Uniform"
                                                                                 HorizontalAlignment="Center"
                                                                                 VerticalAlignment="Center"/>
                                                                    </Button>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Classes="card">
                                <StackPanel Spacing="14">

                                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                                        <Border Grid.Column="0" Classes="icon-box">
                                            <svg:Svg Path="/Assets/ico/blacklist.svg"
                                                     Width="24" Height="24"
                                                     CurrentColor="#FFFFFFFF"
                                                     Stretch="Uniform"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Classes="card-title"
                                                       Text="{Binding Loc[CurrentExcludes]}"/>
                                            <TextBlock Classes="card-desc"
                                                       Text="{Binding Loc[SiteExcludeHint]}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding NewExcludeSiteText, Mode=TwoWay}"
                                                 PlaceholderText="example.com"
                                                 CornerRadius="10"/>
                                        <Button Grid.Column="1"
                                                Classes="primary accent"
                                                Command="{Binding AddExcludeSiteCommand}"
                                                Padding="20,0"
                                                VerticalAlignment="Stretch">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Path Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"
                                                      Fill="White" Width="12" Height="12" Stretch="Uniform"
                                                      VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Loc[BtnAddExcludeSite]}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <Grid ColumnDefinitions="*, Auto" Margin="0,4,0,0">
                                        <TextBlock Grid.Column="0"
                                                   Text="Исключённые домены"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Classes="badge">
                                            <TextBlock Text="{Binding ExcludeSites.Count}"
                                                       FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>

                                    <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                            CornerRadius="10" Padding="10" MinHeight="120" MaxHeight="280">
                                        <Grid>
                                            <TextBlock Classes="empty"
                                                       Text="Нет исключений"
                                                       IsVisible="{Binding !ExcludeSites.Count}"/>
                                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                          IsVisible="{Binding ExcludeSites.Count}">
                                                <ItemsControl ItemsSource="{Binding ExcludeSites}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Classes="chip">
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <TextBlock Text="{Binding}"
                                                                               FontFamily="Consolas, Cascadia Code"
                                                                               FontSize="12"
                                                                               VerticalAlignment="Center"/>
                                                                    <Button Classes="chip-remove"
                                                                            Command="{Binding $parent[UserControl].DataContext.RemoveExcludeSiteCommand}"
                                                                            CommandParameter="{Binding}"
                                                                            ToolTip.Tip="Удалить">
                                                                        <svg:Svg Path="/Assets/ico/x.svg"
                                                                                 Width="12" Height="12"
                                                                                 CurrentColor="{DynamicResource SvgIconColor}"
                                                                                 Stretch="Uniform"
                                                                                 HorizontalAlignment="Center"
                                                                                 VerticalAlignment="Center"/>
                                                                    </Button>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>

        <ItemsControl ItemsSource="{Binding Notifications}"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Margin="24" Width="340" ZIndex="150">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:NotificationItem">
                    <Border Margin="0,0,0,8"
                            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                            CornerRadius="12"
                            BorderThickness="0"
                            Padding="14">
                        <Grid ColumnDefinitions="4, *, Auto">
                            <Panel Grid.Column="0" Width="4">
                                <Border CornerRadius="2" Background="#107C10" IsVisible="{Binding !IsError}"/>
                                <Border CornerRadius="2" Background="#C42B1C" IsVisible="{Binding IsError}"/>
                            </Panel>
                            <StackPanel Grid.Column="1" Margin="12,0" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="{Binding Message}" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Command="{Binding $parent[UserControl].DataContext.DismissNotificationCommand}"
                                    CommandParameter="{Binding}"
                                    Background="Transparent" Padding="0"
                                    Width="24" Height="24" CornerRadius="6"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    VerticalAlignment="Top">
                                <Path Data="{StaticResource IconClose}"
                                      Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                      Width="10" Height="10" Stretch="Uniform"/>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Background="#80000000"
                IsVisible="{Binding IsFakesModalOpen}"
                ZIndex="200">
            <Border Width="480"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    CornerRadius="20"
                    BorderThickness="0"
                    Padding="24">
                <StackPanel Spacing="18">
                    <TextBlock Text="{Binding Loc[FakesModalTitle]}" FontSize="17" FontWeight="Bold"/>

                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding Loc[FakesTypeLabel]}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                        <ComboBox ItemsSource="{Binding FakeTypes}"
                                  SelectedIndex="{Binding SelectedFakeTypeIndex, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"
                                  CornerRadius="10"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding Loc[FakesFileLabel]}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                        <ComboBox ItemsSource="{Binding FakeFiles}"
                                  SelectedIndex="{Binding SelectedFakeFileIndex, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"
                                  CornerRadius="10"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8"
                                HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="{Binding Loc[BtnCancel]}"
                                Classes="ghost"
                                Command="{Binding CloseFakesDialogCommand}"/>
                        <Button Content="{Binding Loc[BtnApply]}"
                                Classes="primary accent"
                                Command="{Binding ApplyFakesCommand}"
                                IsEnabled="{Binding CanApplyFakes}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
