<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ZapretGui.ViewModels"
             x:Class="ZapretGui.Views.AboutView"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             x:DataType="vm:MainViewModel">

    <Grid RowDefinitions="Auto, *" Margin="32,24">
        <TextBlock Grid.Row="0"
                   Text="{Binding Loc[About]}"
                   FontSize="22" FontWeight="Bold"
                   Margin="0,0,0,24"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid RowDefinitions="Auto, Auto" RowSpacing="16">
                <Border Grid.Row="0"
                        CornerRadius="20" Padding="28,24"
                        Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                        BorderBrush="{DynamicResource SystemControlElevationBorderBrush}"
                        BorderThickness="1"
                        BoxShadow="0 4 16 0 #28000000">
                    <Grid ColumnDefinitions="Auto, *, Auto">

                        <Border Grid.Column="0"
                                Width="88" Height="88"
                                CornerRadius="22"
                                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                            <Image Source="/Assets/app-256.ico"
                                   Width="64" Height="64"
                                   RenderOptions.BitmapInterpolationMode="HighQuality"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="24,0,24,0"
                                    Spacing="6">
                            <TextBlock Text="Zapret Control"
                                       FontSize="28" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Loc[AppVersionLabel]}"
                                       FontSize="13"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                        </StackPanel>

                        <Border Grid.Column="2"
                                VerticalAlignment="Center"
                                Background="{DynamicResource SystemAccentColor}"
                                CornerRadius="10"
                                Padding="16,8">
                            <TextBlock Text="{Binding AppVersion}"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="White"/>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" ColumnDefinitions="*, *" ColumnSpacing="16">

                    <Border Grid.Column="0"
                            CornerRadius="16" Padding="24"
                            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                            BorderBrush="{DynamicResource SystemControlElevationBorderBrush}"
                            BorderThickness="1"
                            BoxShadow="0 2 8 0 #20000000">
                        <Grid RowDefinitions="Auto, Auto, *">
                            <Border Grid.Row="0"
                                    Width="56" Height="56"
                                    CornerRadius="14"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                                <svg:Svg Path="/Assets/ico/heart.svg"
                                    Width="28"
                                    Height="28"
                                    CurrentColor="{DynamicResource SvgIconColor}"
                                    Stretch="Uniform"/>
                            </Border>

                            <StackPanel Grid.Row="1" Spacing="4" Margin="0,20,0,20">
                                <TextBlock Text="{Binding Loc[GitHubProjectLabel]}"
                                           FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="qrw512/zapret-control"
                                           FontSize="12"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                            </StackPanel>

                            <Button Grid.Row="2"
                                    Command="{Binding OpenGitHubCommand}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    CornerRadius="10"
                                    Padding="16,10"
                                    VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Loc[OpenInBrowser]}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                    <svg:Svg Path="/Assets/ico/external-link.svg"
                                        Width="12"
                                        Height="12"
                                        CurrentColor="{DynamicResource SvgIconColor}"
                                        Stretch="Uniform"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1"
                            CornerRadius="16" Padding="24"
                            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                            BorderBrush="{DynamicResource SystemControlElevationBorderBrush}"
                            BorderThickness="1"
                            BoxShadow="0 2 8 0 #20000000">
                        <Grid RowDefinitions="Auto, Auto, *">
                            <Border Grid.Row="0"
                                    Width="56" Height="56"
                                    CornerRadius="14"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                                <svg:Svg Path="/Assets/ico/shield-check.svg"
                                    Width="28"
                                    Height="28"
                                    CurrentColor="{DynamicResource SvgIconColor}"
                                    Stretch="Uniform"/>
                            </Border>

                            <StackPanel Grid.Row="1" Spacing="4" Margin="0,20,0,20">
                                <TextBlock Text="Zapret Control"
                                           FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="{Binding SelfUpdateStatusText}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                            </StackPanel>

                            <Button Grid.Row="2"
                                    Content="{Binding Loc[CheckForUpdates]}"
                                    Command="{Binding CheckSelfUpdateCommand}"
                                    IsEnabled="{Binding !IsUpdating}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    Classes="accent"
                                    CornerRadius="10"
                                    Padding="16,10"
                                    FontWeight="SemiBold"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
