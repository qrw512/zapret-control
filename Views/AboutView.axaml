<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ZapretGui.ViewModels"
             x:Class="ZapretGui.Views.AboutView"
             x:DataType="vm:MainViewModel">

    <Grid RowDefinitions="Auto, *" Margin="32,24">
        <TextBlock Grid.Row="0"
                   Text="{Binding Loc[About]}"
                   FontSize="22" FontWeight="Bold"
                   Margin="0,0,0,24"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid RowDefinitions="Auto, Auto" RowSpacing="16">
                <Border Grid.Row="0"
                        CornerRadius="20" Padding="28,24"
                        Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                        BorderBrush="{DynamicResource SystemControlElevationBorderBrush}"
                        BorderThickness="1"
                        BoxShadow="0 4 16 0 #28000000">
                    <Grid ColumnDefinitions="Auto, *, Auto">

                        <Border Grid.Column="0"
                                Width="88" Height="88"
                                CornerRadius="22"
                                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                            <Image Source="/Assets/app-256.ico"
                                   Width="64" Height="64"
                                   RenderOptions.BitmapInterpolationMode="HighQuality"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="24,0,24,0"
                                    Spacing="6">
                            <TextBlock Text="Zapret Control"
                                       FontSize="28" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Loc[AppVersionLabel]}"
                                       FontSize="13"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                        </StackPanel>

                        <Border Grid.Column="2"
                                VerticalAlignment="Center"
                                Background="{DynamicResource SystemAccentColor}"
                                CornerRadius="10"
                                Padding="16,8">
                            <TextBlock Text="{Binding AppVersion}"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="White"/>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" ColumnDefinitions="*, *" ColumnSpacing="16">

                    <Border Grid.Column="0"
                            CornerRadius="16" Padding="24"
                            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                            BorderBrush="{DynamicResource SystemControlElevationBorderBrush}"
                            BorderThickness="1"
                            BoxShadow="0 2 8 0 #20000000">
                        <Grid RowDefinitions="Auto, Auto, *">
                            <Border Grid.Row="0"
                                    Width="56" Height="56"
                                    CornerRadius="14"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                                <Path Data="M12,2A10,10 0 0,0 2,12C2,16.42 4.87,20.17 8.84,21.5C9.34,21.58 9.5,21.27 9.5,21C9.5,20.77 9.5,20.14 9.5,19.31C6.73,19.91 6.14,17.97 6.14,17.97C5.68,16.81 5.03,16.5 5.03,16.5C4.12,15.88 5.1,15.9 5.1,15.9C6.1,15.97 6.63,16.93 6.63,16.93C7.5,18.45 8.97,18 9.54,17.76C9.63,17.11 9.89,16.67 10.17,16.42C7.95,16.17 5.62,15.31 5.62,11.5C5.62,10.39 6,9.5 6.65,8.79C6.55,8.54 6.2,7.5 6.75,6.15C6.75,6.15 7.59,5.88 9.5,7.17C10.29,6.95 11.15,6.84 12,6.84C12.85,6.84 13.71,6.95 14.5,7.17C16.41,5.88 17.25,6.15 17.25,6.15C17.8,7.5 17.45,8.54 17.35,8.79C18,9.5 18.38,10.39 18.38,11.5C18.38,15.32 16.04,16.16 13.81,16.41C14.17,16.72 14.5,17.33 14.5,18.26C14.5,19.6 14.5,20.68 14.5,21C14.5,21.27 14.66,21.59 15.17,21.5C19.14,20.16 22,16.42 22,12A10,10 0 0,0 12,2Z"
                                      Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                      Width="28" Height="28" Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Row="1" Spacing="4" Margin="0,20,0,20">
                                <TextBlock Text="{Binding Loc[GitHubProjectLabel]}"
                                           FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="qrw512/zapret-control"
                                           FontSize="12"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                            </StackPanel>

                            <Button Grid.Row="2"
                                    Command="{Binding OpenGitHubCommand}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    CornerRadius="10"
                                    Padding="16,10"
                                    VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Loc[OpenInBrowser]}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                    <Path Data="M14,3V5H17.59L7.76,14.83L9.17,16.24L19,6.41V10H21V3M19,19H5V5H12V3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V12H19V19Z"
                                          Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                          Width="12" Height="12" Stretch="Uniform"
                                          VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1"
                            CornerRadius="16" Padding="24"
                            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                            BorderBrush="{DynamicResource SystemControlElevationBorderBrush}"
                            BorderThickness="1"
                            BoxShadow="0 2 8 0 #20000000">
                        <Grid RowDefinitions="Auto, Auto, *">
                            <Border Grid.Row="0"
                                    Width="56" Height="56"
                                    CornerRadius="28"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                                <Path Data="M4,6H20V16H4V6M4,4A2,2 0 0,0 2,6V16A2,2 0 0,0 4,18H20A2,2 0 0,0 22,16V6A2,2 0 0,0 20,4H4M1,19V20H23V19H1M18,9.5L16.5,8L11.5,13L9,10.5L7.5,12L11.5,16L18,9.5Z"
                                      Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                      Width="28" Height="28" Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Row="1" Spacing="4" Margin="0,20,0,20">
                                <TextBlock Text="Zapret Control"
                                           FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="{Binding SelfUpdateStatusText}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                            </StackPanel>

                            <Button Grid.Row="2"
                                    Content="{Binding Loc[CheckForUpdates]}"
                                    Command="{Binding CheckSelfUpdateCommand}"
                                    IsEnabled="{Binding !IsUpdating}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    Classes="accent"
                                    CornerRadius="10"
                                    Padding="16,10"
                                    FontWeight="SemiBold"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
