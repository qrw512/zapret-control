<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ZapretGui.ViewModels"
             x:Class="ZapretGui.Views.SettingsView"
             x:DataType="vm:MainViewModel">

    <Grid RowDefinitions="Auto, *" Margin="24">
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *">
            <Button Grid.Column="0" Content="←" Command="{Binding CloseSettingsCommand}"
                    CornerRadius="8" Width="36" Height="36" Padding="0"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Margin="0,0,12,0"/>
            <TextBlock Grid.Column="1" Text="{Binding Loc[SettingsTitle]}"
                       FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,20,0,0">
            <StackPanel Spacing="12">
                <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                        CornerRadius="12" Padding="16,12"
                        BorderBrush="{DynamicResource SystemControlElevationBorderBrush}" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding Loc[PathToZapret]}" FontWeight="SemiBold" FontSize="13"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Text="{Binding ZapretFolderPath, Mode=OneWay}" Grid.Column="0"
                                     Margin="0,0,8,0" IsReadOnly="True" CornerRadius="6"/>
                            <Button x:Name="BrowseButton" Grid.Column="1"
                                    Content="{Binding Loc[Browse]}"
                                    Click="BrowseButton_Click" CornerRadius="6"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                        CornerRadius="12" Padding="16,12"
                        BorderBrush="{DynamicResource SystemControlElevationBorderBrush}" BorderThickness="1">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,12,0">
                            <TextBlock Text="{Binding Loc[AutoStart]}" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="{Binding Loc[AutoStartDesc]}"
                                       FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                      IsChecked="{Binding IsServiceInstalled, Mode=TwoWay}"/>
                    </Grid>
                </Border>
                <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                        CornerRadius="12" Padding="16,12"
                        BorderBrush="{DynamicResource SystemControlElevationBorderBrush}" BorderThickness="1">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,12,0">
                            <TextBlock Text="{Binding Loc[GameFilter]}" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="{Binding Loc[GameFilterDesc]}"
                                       FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" Width="180" CornerRadius="6"
                                  ItemsSource="{Binding GameFilterOptions}"
                                  SelectedIndex="{Binding GameFilterModeIndex, Mode=TwoWay}"/>
                    </Grid>
                </Border>
                <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                        CornerRadius="12" Padding="16,12"
                        BorderBrush="{DynamicResource SystemControlElevationBorderBrush}" BorderThickness="1">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Loc[Theme]}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13"/>
                        <ComboBox Grid.Column="1" Width="160" CornerRadius="6"
                                  ItemsSource="{Binding ThemeOptions}"
                                  SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}"/>
                    </Grid>
                </Border>
                <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                        CornerRadius="12" Padding="16,12"
                        BorderBrush="{DynamicResource SystemControlElevationBorderBrush}" BorderThickness="1">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Loc[Language]}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13"/>
                        <ComboBox x:Name="LanguageComboBox" Grid.Column="1" Width="160" CornerRadius="6">
                            <ComboBoxItem Content="Русский"/>
                            <ComboBoxItem Content="English"/>
                        </ComboBox>
                    </Grid>
                </Border>
                <TextBlock Text="{Binding SettingsStatusText}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="4,4,4,0"
                           IsVisible="{Binding SettingsStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
