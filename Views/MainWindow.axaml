<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ZapretGui.ViewModels"
        xmlns:views="using:ZapretGui.Views"
        xmlns:models="using:ZapretGui.Models"
        xmlns:styling="using:Avalonia.Styling"
        xmlns:controls="using:Avalonia.Controls"
        xmlns:conv="using:ZapretGui.Converters"
        xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
        x:Class="ZapretGui.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Zapret Control"
        Width="1024" Height="600"
        MinWidth="1024" MinHeight="600"
        CanResize="True"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        WindowDecorations="BorderOnly"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/app-256.ico">

    <Window.Styles>

        <Style Selector="Button.power-button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="70"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Opacity" Value="0.55"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.3"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.power-button.running">
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <Style Selector="Button.power-button /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.power-button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.power-button:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="Border.power-circle">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="120"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Background" Value="{DynamicResource BtnColor}"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.3"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Border.power-circle.running">
            <Setter Property="Background" Value="{DynamicResource RunnigBtnColor}"/>
        </Style>

        <Style Selector="Button.power-button:pointerover Border.power-circle">
            <Setter Property="Opacity" Value="0.85"/>
        </Style>
        <Style Selector="Button.power-button:pressed Border.power-circle">
            <Setter Property="Opacity" Value="0.7"/>
        </Style>

        <Style Selector="Border.segmented">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="4"/>
        </Style>

        <Style Selector="RadioButton.segment">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_SegmentBorder"
                            Background="Transparent"
                            CornerRadius="9"
                            Padding="18,8">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="RadioButton.segment:pointerover /template/ Border#PART_SegmentBorder">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseMediumLowBrush}"/>
        </Style>

        <Style Selector="RadioButton.segment:checked /template/ Border#PART_SegmentBorder">
            <Setter Property="Background" Value="{DynamicResource PaletteSecondary}"/>
        </Style>

        <Style Selector="RadioButton.segment:checked">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
        </Style>

        <Style Selector="Button.caption">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.caption:pointerover">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseMediumLowBrush}"/>
        </Style>

        <Style Selector="Button.caption.close:pointerover">
            <Setter Property="Background" Value="#E81123"/>
        </Style>
        <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter">
            <Setter Property="TextElement.Foreground" Value="White"/>
        </Style>

    </Window.Styles>

    <Grid>
        <Grid RowDefinitions="36, *">
            <Grid Grid.Row="0"
                  Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}"
                  ColumnDefinitions="Auto, *, Auto, Auto, Auto"
                  PointerPressed="TitleBar_PointerPressed">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0" Spacing="8" VerticalAlignment="Center">
                    <Image Source="/Assets/app-white.png"
                           Width="18" Height="18"
                           Stretch="Uniform"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapInterpolationMode="HighQuality"
                           IsVisible="{Binding $parent[Window].ActualThemeVariant,
                                       Converter={x:Static ObjectConverters.Equal},
                                       ConverterParameter={x:Static styling:ThemeVariant.Light}}"/>

                    <Image Source="/Assets/app-dark.png"
                           Width="18" Height="18"
                           Stretch="Uniform"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapInterpolationMode="HighQuality"
                           IsVisible="{Binding $parent[Window].ActualThemeVariant,
                                       Converter={x:Static ObjectConverters.Equal},
                                       ConverterParameter={x:Static styling:ThemeVariant.Dark}}"/>

                    <TextBlock Text="Zapret Control" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <Rectangle Grid.Column="1" Fill="Transparent"/>

                <Button Grid.Column="2" Classes="caption"
                        Click="MinimizeButton_Click"
                        ToolTip.Tip="Свернуть">
                    <svg:Svg Path="/Assets/ico/minus.svg"
                             Width="12" Height="12"
                             CurrentColor="{DynamicResource SvgIconColor}"
                             Stretch="Uniform"/>
                </Button>

                <Button Grid.Column="3" Classes="caption"
                        Click="MaximizeButton_Click"
                        ToolTip.Tip="Развернуть">
                    <Panel>
                        <svg:Svg Path="/Assets/ico/maximize.svg"
                                 Width="12" Height="12"
                                 CurrentColor="{DynamicResource SvgIconColor}"
                                 Stretch="Uniform"
                                 IsVisible="{Binding $parent[Window].WindowState,
                                             Converter={x:Static ObjectConverters.NotEqual},
                                             ConverterParameter={x:Static controls:WindowState.Maximized}}"/>
                        <svg:Svg Path="/Assets/ico/minimize.svg"
                                 Width="12" Height="12"
                                 CurrentColor="{DynamicResource SvgIconColor}"
                                 Stretch="Uniform"
                                 IsVisible="{Binding $parent[Window].WindowState,
                                             Converter={x:Static ObjectConverters.Equal},
                                             ConverterParameter={x:Static controls:WindowState.Maximized}}"/>
                    </Panel>
                </Button>

                <Button Grid.Column="4" Classes="caption close"
                        Click="CloseButton_Click"
                        ToolTip.Tip="Закрыть">
                    <svg:Svg Path="/Assets/ico/x.svg"
                             Width="12" Height="12"
                             CurrentColor="{DynamicResource SvgIconColor}"
                             Stretch="Uniform"/>
                </Button>
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="56, Auto, *">

                <Border Grid.Column="0"
                        Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}">
                    <Border.Styles>
                        <Style Selector="Button.nav">
                            <Setter Property="Width" Value="40"/>
                            <Setter Property="Height" Value="40"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="CornerRadius" Value="10"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>
                        <Style Selector="Button.nav:pointerover">
                            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}"/>
                        </Style>
                        <Style Selector="Button.nav.active">
                            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}"/>
                        </Style>
                    </Border.Styles>

                    <Grid RowDefinitions="Auto, *, Auto">
                        <StackPanel Grid.Row="0" Margin="0,10" Spacing="4" HorizontalAlignment="Center">
                            <Button Classes="nav"
                                    Classes.active="{Binding IsBypassPage}"
                                    Command="{Binding ShowBypassPageCommand}"
                                    ToolTip.Tip="{Binding Loc[BypassModes]}">
                                <svg:Svg Path="/Assets/ico/home.svg"
                                         Width="24" Height="24"
                                         CurrentColor="{DynamicResource SvgIconColor}"
                                         Stretch="Uniform"/>
                            </Button>
                            <Button Classes="nav"
                                    Classes.active="{Binding IsToolsPage}"
                                    Command="{Binding OpenServiceViewCommand}"
                                    ToolTip.Tip="{Binding Loc[BtnTools]}">
                                <svg:Svg Path="/Assets/ico/service.svg"
                                         Width="24" Height="24"
                                         CurrentColor="{DynamicResource SvgIconColor}"
                                         Stretch="Uniform"/>
                            </Button>
                            <Button Classes="nav"
                                    Classes.active="{Binding IsTrafficPage}"
                                    Command="{Binding OpenTrafficPageCommand}"
                                    ToolTip.Tip="{Binding Loc[TrafficTitle]}">
                                <svg:Svg Path="/Assets/ico/traffic.svg"
                                         Width="24" Height="24"
                                         CurrentColor="{DynamicResource SvgIconColor}"
                                         Stretch="Uniform"/>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Margin="0,10" Spacing="4" HorizontalAlignment="Center">
                            <Button Classes="nav"
                                    Classes.active="{Binding IsSettingsPage}"
                                    Command="{Binding OpenSettingsCommand}"
                                    ToolTip.Tip="{Binding Loc[SettingsTitle]}">
                                <svg:Svg Path="/Assets/ico/setting.svg"
                                         Width="24" Height="24"
                                         CurrentColor="{DynamicResource SvgIconColor}"
                                         Stretch="Uniform"/>
                            </Button>
                            <Button Classes="nav"
                                    Classes.active="{Binding IsAboutPage}"
                                    Command="{Binding OpenAboutCommand}"
                                    ToolTip.Tip="{Binding Loc[About]}">
                                <svg:Svg Path="/Assets/ico/info.svg"
                                         Width="24" Height="24"
                                         CurrentColor="{DynamicResource SvgIconColor}"
                                         Stretch="Uniform"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="1"
                        Width="320"
                        IsVisible="{Binding IsBypassPage}"
                        Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}">
                    <Grid RowDefinitions="Auto, *">
                        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="20,16,12,12">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Loc[BypassModes]}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>

                            <Button Grid.Column="1"
                                    Width="32" Height="32" Padding="0"
                                    CornerRadius="8"
                                    Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    IsEnabled="{Binding !IsAnyTestRunning}"
                                    ToolTip.Tip="{Binding Loc[PresetMenuTooltip]}">
                                <svg:Svg Path="/Assets/ico/ellipsis.svg"
                                         Width="16" Height="16"
                                         CurrentColor="{DynamicResource SvgIconColor}"
                                         Stretch="Uniform"/>
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuItem Header="{Binding Loc[MenuTestCurrent]}">
                                            <MenuItem Header="{Binding Loc[TestStandard]}"
                                                      Command="{Binding TestCurrentStandardCommand}"/>
                                            <MenuItem Header="{Binding Loc[TestDpi]}"
                                                      Command="{Binding TestCurrentDpiCommand}"/>
                                        </MenuItem>
                                        <Separator/>
                                        <MenuItem Header="{Binding Loc[MenuTestAll]}"
                                                  Command="{Binding TestAllModesCommand}"/>
                                        <Separator/>
                                        <MenuItem Header="{Binding Loc[MenuShowLastResult]}"
                                                  Command="{Binding ShowLastResultCommand}"/>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent">
                            <ListBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"
                                     Margin="12,0,12,12" Background="Transparent" BorderThickness="0" Padding="0">
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,0,8"/>
                                        <Setter Property="CornerRadius" Value="12"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Transitions">
                                            <Transitions>
                                                <BrushTransition Property="Background" Duration="0:0:0.2"/>
                                            </Transitions>
                                        </Setter>
                                    </Style>

                                    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Style>

                                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Style>

                                    <Style Selector="ListBoxItem:selected Border.preset-card">
                                        <Setter Property="Background" Value="{DynamicResource PaletteSecondary}"/>
                                    </Style>

                                    <Style Selector="ListBoxItem:pointerover:not(:selected) Border.preset-card">
                                        <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseMediumLowBrush}"/>
                                    </Style>
                                </ListBox.Styles>
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:ZapretPreset">
                                        <Border Classes="preset-card"
                                                CornerRadius="12" Padding="16,13"
                                                Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
                                            <Grid ColumnDefinitions="*, Auto">
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="3">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                                    <TextBlock Text="Preset / BAT" FontSize="11"
                                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Grid Grid.Column="2">

                    <Grid IsVisible="{Binding IsBypassPage}" RowDefinitions="Auto, *, Auto" Margin="24">
                        <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Zapret Control" FontSize="22" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Loc[MainSubtitle]}"
                                           FontSize="12"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1"
                                CornerRadius="16" Padding="28" Margin="0,20"
                                VerticalAlignment="Center">
                            <StackPanel Spacing="20" HorizontalAlignment="Center">

                                <Button Classes="power-button"
                                        Classes.running="{Binding IsServiceRunning}"
                                        Command="{Binding ToggleServiceCommand}"
                                        HorizontalAlignment="Center"
                                        Width="140" Height="140"
                                        ToolTip.Tip="{Binding ServiceStatusText}">
                                    <Panel>
                                        <Border Classes="power-circle"
                                                Classes.running="{Binding IsServiceRunning}"
                                                IsHitTestVisible="False"/>

                                        <svg:Svg Path="/Assets/ico/power.svg"
                                                 Width="48" Height="48"
                                                 CurrentColor="#FFFFFFFF"
                                                 Stretch="Uniform"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 IsHitTestVisible="False"/>
                                    </Panel>
                                </Button>

                                <TextBlock Text="{Binding ServiceStatusText}"
                                           FontSize="18" FontWeight="Bold"
                                           HorizontalAlignment="Center"/>

                                <StackPanel Spacing="10" HorizontalAlignment="Center">

                                    <Border Classes="segmented" HorizontalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <RadioButton Classes="segment"
                                                        GroupName="BypassMode"
                                                        Content="{Binding Loc[BypassModeAll]}"
                                                        IsChecked="{Binding BypassModeIndex,
                                                                    Converter={x:Static conv:IntEqualsConverter.Instance},
                                                                    ConverterParameter=1}"/>
                                            <RadioButton Classes="segment"
                                                        GroupName="BypassMode"
                                                        Content="{Binding Loc[BypassModeWhitelist]}"
                                                        IsChecked="{Binding BypassModeIndex,
                                                                    Converter={x:Static conv:IntEqualsConverter.Instance},
                                                                    ConverterParameter=0}"/>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="{Binding BypassModeDescription}"
                                               FontSize="11"
                                               MaxWidth="380"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                </StackPanel>

                                <ProgressBar IsIndeterminate="True"
                                             Width="160" Height="4"
                                             HorizontalAlignment="Center"
                                             IsVisible="{Binding IsAnyTestRunning}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2"
                                Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                                CornerRadius="12" Padding="14,10">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding UpdateStatusText}"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center">

                                    <Button Content="{Binding Loc[BtnTestStandard]}"
                                            Command="{Binding TestCurrentStandardCommand}"
                                            IsEnabled="{Binding !IsAnyTestRunning}"
                                            CornerRadius="8"
                                            Padding="14,6"
                                            FontSize="12"
                                            ToolTip.Tip="{Binding Loc[BtnTestStandardTip]}"/>

                                    <Button Content="{Binding Loc[BtnTestDpi]}"
                                            Command="{Binding TestCurrentDpiCommand}"
                                            IsEnabled="{Binding !IsAnyTestRunning}"
                                            CornerRadius="8"
                                            Padding="14,6"
                                            FontSize="12"
                                            ToolTip.Tip="{Binding Loc[BtnTestDpiTip]}"/>

                                    <Button Classes="accent"
                                            Content="{Binding Loc[Update]}"
                                            Command="{Binding CheckAndInstallUpdatesCommand}"
                                            IsVisible="{Binding IsUpdateAvailable}"
                                            IsEnabled="{Binding !IsUpdating}"
                                            CornerRadius="8"
                                            Padding="14,6"
                                            FontSize="12"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <views:SettingsView IsVisible="{Binding IsSettingsPage}"/>

                    <Panel IsVisible="{Binding IsToolsPage}">
                        <views:ServiceView DataContext="{Binding ServiceViewModel}"/>
                    </Panel>

                    <Panel IsVisible="{Binding IsTrafficPage}">
                        <views:TrafficView DataContext="{Binding TrafficViewModel}"/>
                    </Panel>

                    <views:AboutView IsVisible="{Binding IsAboutPage}"/>
                </Grid>
            </Grid>
        </Grid>
        <Border Background="#80000000"
                IsVisible="{Binding IsTestModalOpen}"
                ZIndex="100">
            <Border Width="720" MaxHeight="520"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    CornerRadius="16"
                    Padding="20"
                    BoxShadow="0 8 32 0 #60000000">
                <Grid RowDefinitions="Auto, Auto, *, Auto">
                    <TextBlock Grid.Row="0"
                               Text="{Binding TestModalTitle}"
                               FontSize="16" FontWeight="Bold"
                               TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="1"
                               Text="{Binding TestModalSubtitle}"
                               FontSize="12"
                               Margin="0,4,0,12"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>

                    <Border Grid.Row="2"
                            Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                            CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <SelectableTextBlock Text="{Binding TestModalBody}"
                                                 FontFamily="Consolas, Cascadia Code, Courier New"
                                                 FontSize="11"
                                                 TextWrapping="Wrap"
                                                 Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                        </ScrollViewer>
                    </Border>

                    <Button Grid.Row="3"
                            Content="{Binding Loc[BtnClose]}"
                            Command="{Binding CloseTestModalCommand}"
                            Classes="accent"
                            HorizontalAlignment="Right"
                            CornerRadius="8" Padding="16,8"/>
                </Grid>
            </Border>
        </Border>
        <Border Background="#80000000"
                IsVisible="{Binding IsSelfUpdateOpen}"
                ZIndex="200">
            <Border Width="520"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    CornerRadius="16"
                    Padding="24"
                    BoxShadow="0 8 32 0 #60000000">
                <StackPanel Spacing="16">

                    <TextBlock Text="{Binding Loc[SelfUpdateTitle]}"
                               FontSize="16" FontWeight="Bold"/>

                    <TextBlock Text="{Binding SelfUpdateMessage}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>

                    <ProgressBar Minimum="0" Maximum="100"
                                 Value="{Binding SelfUpdateProgress}"
                                 Height="8"
                                 CornerRadius="4"
                                 IsVisible="{Binding IsSelfUpdateProgressVisible}"/>

                    <StackPanel Orientation="Horizontal" Spacing="8"
                                HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="{Binding Loc[SelfUpdateNo]}"
                                Command="{Binding DismissSelfUpdateCommand}"
                                IsEnabled="{Binding IsSelfUpdateReady}"
                                CornerRadius="8" Padding="16,8"/>
                        <Button Content="{Binding Loc[SelfUpdateYes]}"
                                Command="{Binding ApplySelfUpdateCommand}"
                                IsEnabled="{Binding IsSelfUpdateReady}"
                                Classes="accent"
                                CornerRadius="8" Padding="16,8"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
